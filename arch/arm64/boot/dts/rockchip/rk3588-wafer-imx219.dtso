/*
 * Device tree overlay for a Sony IMX219 camera module attached to the
 * MIPI CSI connector of the IEI WAFER-RK3588.
 *
 * Copyright (c) 2026 IEI Integration Corp.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/clock/rockchip,rk3588-cru.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

&{/} {
	vcc1v8_camera: regulator-vcc1v8-camera {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8_camera";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3_s0>;
	};

	vcc2v8_camera: regulator-vcc2v8-camera {
		compatible = "regulator-fixed";
		regulator-name = "vcc2v8_camera";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		vin-supply = <&vcc_3v3_s0>;
	};
};

&csi0 {
	status = "okay";
};

&csi0_in {
	csi0_input: endpoint {
		clock-lanes = <0>;
		data-lanes = <1 2>;
		remote-endpoint = <&imx219_out>;
	};
};

&i2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m2_xfer>;
	status = "okay";

	camera@10 {
		compatible = "sony,imx219";
		reg = <0x10>;
		clocks = <&cru CLK_MIPI_CAMARAOUT_M1>;
		assigned-clocks = <&cru CLK_MIPI_CAMARAOUT_M1>;
		assigned-clock-rates = <24000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&mipim0_camera1_clk &camera_pwdn>;
		VANA-supply = <&vcc2v8_camera>;
		VDIG-supply = <&vcc1v8_camera>;
		VDDL-supply = <&avdd_1v2_s0>;
		reset-gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;

		port {
			imx219_out: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <456000000>;
				remote-endpoint = <&csi0_input>;
			};
		};
	};
};

&mipidcphy0 {
	status = "okay";
};

&pinctrl {
	camera {
		camera_pwdn: camera-pwdn {
			rockchip,pins = <1 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&vicap {
	status = "okay";
};

&vicap_mmu {
	status = "okay";
};
